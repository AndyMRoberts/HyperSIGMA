import os
import pandas as pd
import time
from datetime import datetime
import gc

gc.collect()
torch.cuda.empty_cache()

results = []
max_epoch = 1
patience = 10
timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
run_dir = f'{path_result}{timestamp}_spatsigma'
os.makedirs(run_dir, exist_ok=True)

notes = 'Running with added validation loss, same hyperparameters as initial notebook.'
with open(f'{run_dir}/notes.txt', 'w') as f:
    f.write(notes + '\n')


for size in ['base', 'large']: # huge has memory issue
    # weights/hypersigma/spat-vit-base-ultra-checkpoint-1599.pth
    model_path = f"../weights/hypersigma/spat-vit-{size}-ultra-checkpoint-1599.pth"
    if size == 'base':
        embed_dim = 768
        depth = 12
        num_heads=12
        out_indices = [3, 5, 7, 11]
    elif size == 'large':
        embed_dim = 1024
        depth = 24
        num_heads=16
        out_indices = [7, 11, 15, 23]
    elif size == 'huge':
        embed_dim = 1280
        depth = 32
        num_heads=16
        out_indices = [10, 15, 20, 31]

    model = SpatViT_cls.SpatViT (img_size=img_size,
                num_classes = class_num+1,
                in_chans=pca_components,
                patch_size=patch_size,
                drop_path_rate=0.1,
                out_indices=out_indices,
                embed_dim=embed_dim,
                depth=depth,
                num_heads=num_heads,
                mlp_ratio=4,
                qkv_bias=True,
                qk_scale=None,
                drop_rate=0.,
                attn_drop_rate=0.,
                use_checkpoint=True,
                use_abs_pos_emb=True,
                interval=3,
                n_points=8)
    per_net = torch.load((model_path), map_location=torch.device('cpu'), weights_only=False)
    model_params = model.state_dict()
    for k in list(per_net['model'].keys()):
        if 'patch_embed.proj' in k:
            del per_net['model'][k]
        if 'pos_embed' in k:
            del per_net['model'][k]
    same_parsms = {k: v for k, v in per_net['model'].items() if k in model_params.keys()}
    model_params.update(same_parsms)
    model.load_state_dict(model_params)

    same_parsms
    optim_wrapper = dict(
        optimizer=dict(
        type='AdamW', lr=6e-5, betas=(0.9, 0.999), weight_decay=0.05),
        constructor='LayerDecayOptimizerConstructor_ViT', 
        paramwise_cfg=dict(
            num_layers=depth, 
            layer_decay_rate=0.9,
            )
            )
    optimizer = build_optim_wrapper(model, optim_wrapper)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer.optimizer, max_epoch, eta_min=0, last_epoch=-1)
    criterion = nn.CrossEntropyLoss()
    model.to(device)
    best_loss = float('inf')
    epochs_without_improvement = 0
    train_losses = []
    val_losses = []
    epoch_durations = []
    total_train_time_start = time.time()
    for epoch in range(max_epoch + 1):
        start_time = time.time()
        correct = 0
        total = 0
        test_correct = 0
        test_total = 0
        _train_loss = 0
        n_train = 0
        model.train()
        for x, y in train_loader:
            if torch.cuda.is_available():
                x, y = x.to(device), y.to(device)
            y_pred = model(x)
            train_loss = criterion(y_pred, y)
            optimizer.zero_grad()
            train_loss.backward()
            optimizer.step()
            _train_loss += train_loss.item() * y.size(0)
            n_train += y.size(0)

            with torch.no_grad():
                y_pred = torch.argmax(y_pred, dim=1)
                correct = (y_pred == y).sum().item()
                total = y.size(0)

        epoch_loss = _train_loss / n_train
        epoch_accuracy = correct / total
        train_losses.append(epoch_loss)
        epoch_durations.append(time.time() - start_time)

        model.eval()
        _val_loss = 0
        n_val = 0
        with torch.no_grad():
            for x, y in val_loader:
                if torch.cuda.is_available():
                    x, y = x.to(device), y.to(device)
                val_pred = model(x)
                val_loss = criterion(val_pred, y)
                _val_loss += val_loss.item() * y.size(0)
                n_val += y.size(0)
        val_epoch_loss = _val_loss / n_val
        val_losses.append(val_epoch_loss)

        if val_epoch_loss < best_loss:
            best_loss = val_epoch_loss
            epochs_without_improvement = 0
            torch.save(model.state_dict(), path_weight + "spat_" + size + "_model.pth")
            torch.save(optimizer.state_dict(), path_weight + "spat_" + size + '_optimizer.pth')
            print('save model')
        else:
            epochs_without_improvement += 1

        if epoch % 10 == 0 or epochs_without_improvement >= patience:
            print(
                'model:', size,
                'epoch:', epoch,
                'train loss:', round(epoch_loss, 5),
                'val loss:', round(val_epoch_loss, 5),
                'accuracy:', round(epoch_accuracy, 5),
            )

        if epochs_without_improvement >= patience:
            print('early stopping at epoch', epoch)
            break

    fig, ax = plt.subplots(figsize=(8, 4))
    ax.plot(range(len(train_losses)), train_losses, label='train')
    ax.plot(range(len(val_losses)), val_losses, label='validation')
    ax.set_xlabel('epoch')
    ax.set_ylabel('loss')
    ax.set_title(f'{size} train and validation loss')
    ax.legend()
    fig.tight_layout()
    fig.savefig(f'{run_dir}/loss_{size}.png', dpi=150)
    plt.show()

    count = 0
    model.load_state_dict(torch.load(path_weight + r"model.pth"))
    model.eval()
    with torch.no_grad():
        for x, y  in test_loader:
            if torch.cuda.is_available():
                x, y = x.to(device), y.to(device)
            inference_start = time.time()
            output = model(x)
            inference_time = time.time() - inference_start
            y_pred = torch.argmax(output, dim=1)
            test_correct += (y_pred == y).sum().item()
            test_total += y.size(0)

            # np。concatenate 不能拼接空数组，所以这里在第一个的时候不拼接，后面的时候才拼接
            if count == 0:
                y_pred_test =  y_pred.cpu().numpy()
                y_gt_test = y.cpu().numpy()
                count = 1
            else:
                y_pred_test = np.concatenate( (y_pred_test, y_pred.cpu().numpy()) )
                y_gt_test = np.concatenate( (y_gt_test, y.cpu().numpy()) )

    overall_acc = metrics.accuracy_score(y_pred_test, y_gt_test)
    confusion_matrix = metrics.confusion_matrix(y_pred_test, y_gt_test)
    each_acc, average_acc = utils.aa_and_each_accuracy(confusion_matrix)
    kappa = metrics.cohen_kappa_score(y_pred_test, y_gt_test)
    OA_HybirdSN = test_correct / test_total
    print("test OA={:.4f}".format(overall_acc))
    print('kappa=',kappa)
    print('each_acc=',each_acc)
    print('average_acc=',average_acc)

    time_per_epoch = float(np.mean(epoch_durations))
    epochs_run = len(epoch_durations)
    total_time = time.time() - total_train_time_start

    results.append({
        "size": size, 
        "epochs": epochs_run,
        "best val loss": best_loss,
        "OA": overall_acc,
        "AA": average_acc,
        "kappa": kappa,
        "time per epoch": time_per_epoch,
        "total time": total_time,
        "inference time": inference_time,
        "OA/time": overall_acc / time_per_epoch,
    })

# One row per seed; the summary is mean and std (pandas default ddof=1) across seeds.
df = pd.DataFrame(results)
df.to_csv(f'{run_dir}/benchmarking.csv')
display(df)

